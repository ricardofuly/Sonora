{
  "name": "sonora",
  "productName": "Sonora",
  "private": true,
  "version": "1.1.1",
  "description": "Player de músicas do YouTube e da sua biblioteca local",
  "author": "Sonora",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"node server.js\" \"vite\"",
    "build": "vite build",
    "start": "node server.js",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.2.1",
    "electron-updater": "^6.3.9",
    "express": "^4.21.2",
    "music-metadata": "^11.16.1",
    "youtubei.js": "^18.3.0",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@fontsource-variable/inter": "^5.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.sonora.player",
    "productName": "Sonora",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server.js",
      "dist/**",
      "scripts/mediakeys.ps1",
      "package.json"
    ],
    "asarUnpack": [
      "scripts/mediakeys.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sonora",
      "artifactName": "Sonora-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ricardofuly",
        "repo": "Sonora",
        "releaseType": "release"
      }
    ]
  }
}
